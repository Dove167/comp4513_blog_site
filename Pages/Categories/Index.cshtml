@page
@model blogsite.Pages_Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-dark">Categories</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Create New Category
    </a>
</div>

@if (Model.Category.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-tags display-1 text-muted"></i>
        <h3 class="mt-3 text-muted">No categories yet</h3>
        <p class="text-muted">Create your first category!</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Category)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">@item.Name</h5>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <div class="btn-group w-100">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
