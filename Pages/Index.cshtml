@page
@model IndexModel
@{
    ViewData["Title"] = "My Blog";
}

<div class="text-center py-5 bg-light rounded-3 mb-5">
    <h1 class="display-4 fw-bold text-dark">Welcome to My Blog</h1>
    <p class="lead text-muted">Share your thoughts with the world</p>
    <a asp-page="/Posts/Create" class="btn btn-primary btn-lg mt-2">
        <i class="bi bi-plus-circle me-2"></i>Create Your First Post
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <h2 class="fw-bold text-dark mb-4">Latest Posts</h2>

        @if (Model.Posts.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x display-1 text-muted"></i>
                <h3 class="mt-3 text-muted">No posts yet</h3>
                <p class="text-muted">Start writing your first post!</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var post in Model.Posts)
                {
                    <div class="col-12">
                        <div class="card h-100 shadow-sm post-card">
                            <div class="card-body">
                                <h4 class="card-title fw-bold">@post.Title</h4>
                                <p class="card-text text-muted">@post.Excerpt</p>
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i>@post.CreatedAt.ToString("MMM dd, yyyy")
                                </small>
                            </div>
                            <div class="card-footer bg-transparent border-top-0">
                                <a asp-page="/Posts/Details" asp-route-id="@post.Id" class="btn btn-outline-primary">
                                    <i class="bi bi-book me-2"></i>Read More
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-folder me-2"></i>Categories</h5>
            </div>
            <div class="card-body">
                @if (Model.PostsByCategory.Count == 0)
                {
                    <p class="text-muted mb-0">No categories yet</p>
                }
                else
                {
                    @foreach (var categoryGroup in Model.PostsByCategory)
                    {
                        <div class="mb-3">
                            <h6 class="fw-bold text-primary mb-2">@categoryGroup.Key.Name</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var post in categoryGroup.Value)
                                {
                                    <li class="mb-1">
                                        <a asp-page="/Posts/Details" asp-route-id="@post.Id" class="text-decoration-none">
                                            @post.Title
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>
