@page
@model blogsite.Pages_Posts.DetailsModel

@{
    ViewData["Title"] = Model.Post.Title;
}

<h1 class="mb-4">@Model.Post.Title</h1>

<div class="row">
    <div class="col-md-8">
        <p class="lead">@Model.Post.Content</p>
        
        <div class="mt-4">
            <a asp-page="./Edit" asp-route-id="@Model.Post.Id" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <a asp-page="./Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Back to List
            </a>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-link-45deg me-2"></i>Related Posts</h5>
            </div>
            <div class="card-body">
                @if (Model.RelatedPosts.Count == 0)
                {
                    <p class="text-muted mb-0">No related posts yet</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var relatedPost in Model.RelatedPosts)
                        {
                            <li class="mb-2">
                                <a asp-page="./Details" asp-route-id="@relatedPost.Id" class="text-decoration-none">
                                    @relatedPost.Title
                                </a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
