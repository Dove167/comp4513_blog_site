@page
@model blogsite.Pages_Posts.IndexModel

@{
    ViewData["Title"] = "My Posts";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold text-dark">My Posts</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>Create New Post
    </a>
</div>

@if (Model.Post.Count == 0)
{
    <div class="text-center py-5">
        <i class="bi bi-journal-x display-1 text-muted"></i>
        <h3 class="mt-3 text-muted">No posts yet</h3>
        <p class="text-muted">Start by creating your first post!</p>
        <a asp-page="Create" class="btn btn-primary mt-2">Create Your First Post</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model.Post)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm post-card">
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">@item.Title</h5>
                        <p class="card-subtitle text-muted">@item.Author?.FirstName @item.Author?.LastName</p>
                        <span class="text-muted"> in 
                            <a asp-page="/Categories/Details" asp-route-id="@item.Category?.Id">
                                @item.Category?.Name</a>
                        </span>
                        <p class="card-text text-muted">@item.Content</p>
                        <small class="text-muted">
                            <i class="bi bi-calendar3 me-1"></i>@item.CreatedAt.ToString("MMM dd, yyyy")
                        </small>
                    </div>
                    <div class="card-footer bg-transparent border-top-0">
                        <div class="btn-group w-100">
                            <a asp-page="./Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </a>
                            <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i>Delete
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
