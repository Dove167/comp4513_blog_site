@page
@model blogsite.Pages_Posts.DeleteModel

@{
    ViewData["Title"] = "Delete Post";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-trash me-2"></i>Delete Post</h4>
            </div>
            <div class="card-body">
                <h3 class="text-danger mb-4">Are you sure you want to delete this?</h3>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Title</label>
                    <p class="form-control-plaintext fs-5">@Model.Post.Title</p>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Content</label>
                    <p class="form-control-plaintext">@Model.Post.Content</p>
                </div>
                
                <div class="mb-3">
                    <label class="form-label fw-bold">Created</label>
                    <p class="form-control-plaintext text-muted">
                        <i class="bi bi-calendar3 me-1"></i>@Model.Post.CreatedAt.ToString("MMM dd, yyyy")
                    </p>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <form method="post" class="d-flex gap-2">
                    <input type="hidden" asp-for="Post.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-2"></i>Delete
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Back to List
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
