@page
@model blogsite.Pages_Authors.DetailsModel

@{
    ViewData["Title"] = "Author Details";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0"><i class="bi bi-person me-2"></i>Author Details</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">First Name</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Author.FirstName)</dd>
                    <dt class="col-sm-3">Last Name</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.Author.LastName)</dd>
                </dl>
            </div>
            <div class="card-footer bg-transparent">
                <a asp-page="./Edit" asp-route-id="@Model.Author.Id" class="btn btn-warning">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a>
                <a asp-page="./Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Back to List
                </a>
            </div>
        </div>
    </div>
</div>
